SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8484/callback
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Listen on all network interfaces. Use 127.0.0.1 for this PC only.
HOST=0.0.0.0
PORT=8484
# Optional HTTPS certificate and private key (PEM files).
# Required for Spotify sign-in by network IP unless using an HTTPS reverse proxy.
SSL_CERT_FILE=
SSL_KEY_FILE=
